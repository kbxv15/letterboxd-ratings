{
  "manifest_version": 3,
  "name": "Letterboxd Ratings on Hover",
  "short_name": "LB Ratings",
  "version": "1.0.0",
  "description": "Hover any film title or poster on Letterboxd to see its Letterboxd, IMDb and Rotten Tomatoes ratings.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.imdb.com/*",
    "https://www.rottentomatoes.com/*",
    "https://query.wikidata.org/*",
    "https://www.omdbapi.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Letterboxd Ratings on Hover",
    "default_popup": "options.html"
  },
  "content_scripts": [
    {
      "matches": ["https://letterboxd.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
